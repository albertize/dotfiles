{
    "name": "Ion",
    "author": "Ion project palette",
    "variables": {
        "ion_window": "#15171B",
        "ion_background": "#181A1F",
        "ion_foreground": "#D8DEE9",
        "ion_current_line": "#1D2128",
        "ion_gutter": "#16181D",
        "ion_gutter_muted": "#69717E",
        "ion_gutter_active": "#BEC6D2",
        "ion_border": "#30343D",
        "ion_accent": "#5AA7E8",
        "ion_selection": "#284D6FD7",
        "ion_comment": "#70976A",
        "ion_string": "#E0AC6B",
        "ion_number": "#BE95E0",
        "ion_keyword": "#E07EAA",
        "ion_type": "#67B7DE",
        "ion_preprocessor": "#B78BCF",
        "ion_property": "#70C0BE",
        "ion_heading": "#5FAEE6",
        "ion_deleted": "#DC6969",
        "ion_added": "#73C382",
        "ion_modified": "#E1AF5F"
    },
    "globals": {
        "background": "var(ion_background)",
        "foreground": "var(ion_foreground)",
        "accent": "var(ion_accent)",
        "caret": "#EEF1F6",
        "block_caret": "#EEF1F6",
        "line_highlight": "var(ion_current_line)",
        "selection": "var(ion_selection)",
        "selection_border": "#5AA7E8A0",
        "inactive_selection": "#284D6F88",
        "inactive_selection_border": "#59616D90",
        "selection_corner_style": "round",
        "selection_corner_radius": "2",
        "gutter": "var(ion_gutter)",
        "gutter_foreground": "var(ion_gutter_muted)",
        "gutter_foreground_highlight": "var(ion_gutter_active)",
        "margin": "var(ion_window)",
        "fold_marker": "var(ion_gutter_muted)",
        "minimap_border": "var(ion_border)",
        "misspelling": "var(ion_deleted)",
        "shadow": "#00000050",
        "guide": "#30343D90",
        "active_guide": "#59616D",
        "stack_guide": "#59616D80",
        "highlight": "#5AA7E85A",
        "find_highlight": "var(ion_modified)",
        "find_highlight_foreground": "var(ion_window)",
        "brackets_options": "underline",
        "brackets_foreground": "var(ion_type)",
        "bracket_contents_options": "underline",
        "bracket_contents_foreground": "var(ion_property)",
        "tags_options": "stippled_underline",
        "tags_foreground": "var(ion_keyword)",
        "rulers": "var(ion_border)",
        "line_diff_width": "3",
        "line_diff_added": "var(ion_added)",
        "line_diff_modified": "var(ion_modified)",
        "line_diff_deleted": "var(ion_deleted)"
    },
    "rules": [
        {
            "name": "Comments",
            "scope": "comment, punctuation.definition.comment",
            "foreground": "var(ion_comment)"
        },
        {
            "name": "Strings",
            "scope": "string, punctuation.definition.string",
            "foreground": "var(ion_string)"
        },
        {
            "name": "Regular expressions",
            "scope": "string.regexp, string.other.link",
            "foreground": "var(ion_string)"
        },
        {
            "name": "Escape sequences",
            "scope": "constant.character.escape, constant.other.placeholder",
            "foreground": "var(ion_preprocessor)"
        },
        {
            "name": "Numbers",
            "scope": "constant.numeric, constant.language, constant.character, constant.other",
            "foreground": "var(ion_number)"
        },
        {
            "name": "Keywords",
            "scope": "keyword, storage.modifier, storage.type - storage.type.numeric",
            "foreground": "var(ion_keyword)"
        },
        {
            "name": "Operators",
            "scope": "keyword.operator, punctuation.definition.keyword",
            "foreground": "var(ion_keyword)"
        },
        {
            "name": "Types and classes",
            "scope": "entity.name.type, entity.name.class, entity.name.struct, entity.name.enum, entity.other.inherited-class, support.type, support.class, support.other.namespace, storage.type.numeric",
            "foreground": "var(ion_type)"
        },
        {
            "name": "Functions",
            "scope": "entity.name.function, variable.function, support.function, support.macro",
            "foreground": "var(ion_type)"
        },
        {
            "name": "Preprocessor and imports",
            "scope": "meta.preprocessor, keyword.control.import, keyword.control.include, punctuation.definition.directive, entity.name.import",
            "foreground": "var(ion_preprocessor)"
        },
        {
            "name": "Properties and members",
            "scope": "variable.member, variable.other.member, support.variable.property, entity.other.attribute-name, meta.mapping.key string, meta.object-literal.key",
            "foreground": "var(ion_property)"
        },
        {
            "name": "Parameters",
            "scope": "variable.parameter",
            "foreground": "var(ion_foreground)"
        },
        {
            "name": "Language variables",
            "scope": "variable.language, support.variable",
            "foreground": "var(ion_property)"
        },
        {
            "name": "Annotations and decorators",
            "scope": "meta.annotation, meta.decorator, punctuation.definition.annotation, variable.annotation",
            "foreground": "var(ion_preprocessor)"
        },
        {
            "name": "Tags",
            "scope": "entity.name.tag, punctuation.definition.tag",
            "foreground": "var(ion_keyword)"
        },
        {
            "name": "HTML and XML attributes",
            "scope": "entity.other.attribute-name, meta.attribute-with-value entity.other.attribute-name",
            "foreground": "var(ion_property)"
        },
        {
            "name": "CSS selectors",
            "scope": "meta.selector, entity.other.attribute-name.class.css, entity.other.attribute-name.id.css, entity.name.tag.css",
            "foreground": "var(ion_type)"
        },
        {
            "name": "CSS properties",
            "scope": "support.type.property-name.css, meta.property-name.css",
            "foreground": "var(ion_property)"
        },
        {
            "name": "JSON, TOML and YAML keys",
            "scope": "source.json meta.mapping.key string, source.toml entity.other.attribute-name, source.yaml entity.name.tag",
            "foreground": "var(ion_property)"
        },
        {
            "name": "Markdown headings",
            "scope": "markup.heading, markup.heading punctuation.definition.heading, entity.name.section",
            "foreground": "var(ion_heading)",
            "font_style": "bold"
        },
        {
            "name": "Markdown emphasis",
            "scope": "markup.italic",
            "foreground": "var(ion_foreground)",
            "font_style": "italic"
        },
        {
            "name": "Markdown strong",
            "scope": "markup.bold",
            "foreground": "var(ion_foreground)",
            "font_style": "bold"
        },
        {
            "name": "Markdown links",
            "scope": "markup.underline.link, string.other.link.description, meta.link.inline",
            "foreground": "var(ion_string)"
        },
        {
            "name": "Markdown code",
            "scope": "markup.raw, markup.raw.inline, markup.raw.block",
            "foreground": "var(ion_property)"
        },
        {
            "name": "Markdown quotes",
            "scope": "markup.quote, punctuation.definition.blockquote",
            "foreground": "var(ion_comment)"
        },
        {
            "name": "Shell variables",
            "scope": "variable.other.readwrite.shell, variable.other.normal.shell, punctuation.definition.variable.shell",
            "foreground": "var(ion_property)"
        },
        {
            "name": "Diff inserted",
            "scope": "markup.inserted, meta.diff.header.to-file",
            "foreground": "var(ion_added)"
        },
        {
            "name": "Diff changed",
            "scope": "markup.changed",
            "foreground": "var(ion_modified)"
        },
        {
            "name": "Diff deleted",
            "scope": "markup.deleted, meta.diff.header.from-file",
            "foreground": "var(ion_deleted)"
        },
        {
            "name": "Diff headers",
            "scope": "meta.diff, meta.diff.header, meta.separator.diff",
            "foreground": "var(ion_heading)"
        },
        {
            "name": "Invalid",
            "scope": "invalid",
            "foreground": "#F1F6FA",
            "background": "var(ion_deleted)"
        },
        {
            "name": "Deprecated",
            "scope": "invalid.deprecated",
            "foreground": "var(ion_modified)",
            "font_style": "underline"
        }
    ]
}
