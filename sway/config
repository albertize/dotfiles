# Sway desktop configuration. Colors, toolkit variables, wallpaper, and fonts
# come from the profiles selected by the command-line switchers.
set $mod Mod4
include ~/.config/dotfiles-theme/sway.conf
include ~/.config/dotfiles-font/sway.conf
set $term $theme_env alacritty
set $menu $theme_env wofi --show drun --allow-images
# Work around Flameshot geometry errors on fractionally scaled Wayland outputs.
set $screenshot $theme_env env QT_AUTO_SCREEN_SCALE_FACTOR=1 sh -c 'exec "${XDG_CONFIG_HOME:-$HOME/.config}/sway/scripts/flameshot.sh" "$@"' sh

# Window gaps and borders, in logical pixels.
set $gaps 3
set $border 3

### Appearance
# Initial layout for the usual 1920x1080 external mode. output-manager.sh
# recalculates the laptop position from the active monitor's logical rectangle
# so mode changes cannot create overlapping outputs. The laptop's 1920x1200
# panel is 1536 logical pixels wide at 125% scaling.
output HDMI-A-1 {
    position 0 0
    scale 1
}
output DP-3 {
    position 0 0
    scale 1
}
output eDP-1 {
    position 192 1080
    scale 1.25
}

gaps inner $gaps
gaps outer $gaps
default_border pixel $border
default_floating_border pixel $border
hide_edge_borders none

### Input
input type:keyboard {
    xkb_layout it
    repeat_delay 300
    repeat_rate 40
}

input type:touchpad {
    tap enabled
    drag enabled
    drag_lock disabled
    natural_scroll enabled
    dwt enabled
}

# Keep the pointer visible even when it is idle.
seat * hide_cursor 0

### Startup
exec --no-startup-id $theme_env sh -c 'config_home=${XDG_CONFIG_HOME:-"$HOME/.config"}; exec "$config_home/sway/scripts/session.sh"'
exec_always --no-startup-id sh -c 'config_home=${XDG_CONFIG_HOME:-"$HOME/.config"}; exec "$config_home/waybar/scripts/bluetooth-state.sh" restore'
exec_always --no-startup-id $theme_env sh -c 'config_home=${XDG_CONFIG_HOME:-"$HOME/.config"}; exec "$config_home/waybar/scripts/output-manager.sh"'
exec_always --no-startup-id sh -c 'pkill xsettingsd 2>/dev/null || true; config_home=${XDG_CONFIG_HOME:-"$HOME/.config"}; exec xsettingsd --config="$config_home/dotfiles-runtime/xsettingsd.conf"'
exec_always --no-startup-id sh -c 'pkill dunst 2>/dev/null || true; config_home=${XDG_CONFIG_HOME:-"$HOME/.config"}; exec dunst --config "$config_home/dotfiles-runtime/dunstrc"'
# Build script paths in two steps so each pkill pattern cannot match its own
# launcher command during a configuration reload.
exec_always --no-startup-id sh -c 'script="$HOME/.config/sway/scripts/clipboard-history"; pkill -f "[c]lipboard-history.sh" 2>/dev/null || true; exec "$script.sh"'
# Automatic Fibonacci arrangement with alternating equal splits.
exec_always --no-startup-id sh -c 'script="$HOME/.config/sway/scripts/golden-layout"; pkill -f "[g]olden-layout.sh" 2>/dev/null || true; exec "$script.sh"'
# Turn off idle displays without locking the session automatically.
exec swayidle -w \
    timeout 600 'swaymsg "output * power off"' \
    resume 'swaymsg "output * power on"'

### Applications
bindsym $mod+Return exec $term
bindsym $mod+d exec $menu
# Lock the session manually using the current wallpaper; use Mod+Right to move
# focus to the right.
bindsym $mod+l exec sh -c 'exec "${XDG_CONFIG_HOME:-$HOME/.config}/sway/scripts/lock.sh"'
bindsym $mod+q kill
bindsym Print exec $screenshot gui
bindsym Shift+Print exec $screenshot full --clipboard
bindsym $mod+n exec dunstctl history-pop
bindsym $mod+Shift+n exec dunstctl close-all
bindsym $mod+Ctrl+n exec sh -c 'exec "${XDG_CONFIG_HOME:-$HOME/.config}/waybar/scripts/notifications-menu.sh" toggle-pause'

# Audio and brightness
bindsym XF86AudioRaiseVolume exec sh -c 'exec "${XDG_CONFIG_HOME:-$HOME/.config}/sway/scripts/volume.sh" up'
bindsym XF86AudioLowerVolume exec sh -c 'exec "${XDG_CONFIG_HOME:-$HOME/.config}/sway/scripts/volume.sh" down'
bindsym XF86AudioMute exec sh -c 'exec "${XDG_CONFIG_HOME:-$HOME/.config}/sway/scripts/volume.sh" mute'
bindsym XF86AudioMicMute exec sh -c 'exec "${XDG_CONFIG_HOME:-$HOME/.config}/sway/scripts/volume.sh" mic-mute'
bindsym XF86MonBrightnessUp exec sh -c 'exec "${XDG_CONFIG_HOME:-$HOME/.config}/sway/scripts/brightness.sh" up'
bindsym XF86MonBrightnessDown exec sh -c 'exec "${XDG_CONFIG_HOME:-$HOME/.config}/sway/scripts/brightness.sh" down'

### Focus and movement
set $left h
set $down j
set $up k
set $right l

bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

### Workspace
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
# The laptop workspace has no numeric label, but remains available on Mod+0.
set $ws10 ""

# Prefer numbered workspaces on the external display and the dedicated laptop
# workspace on the internal panel. The second output is a fallback when the
# preferred output is disconnected.
workspace $ws1 output HDMI-A-1 DP-3 eDP-1
workspace $ws2 output HDMI-A-1 DP-3 eDP-1
workspace $ws3 output HDMI-A-1 DP-3 eDP-1
workspace $ws4 output HDMI-A-1 DP-3 eDP-1
workspace $ws5 output HDMI-A-1 DP-3 eDP-1
workspace $ws6 output HDMI-A-1 DP-3 eDP-1
workspace $ws7 output HDMI-A-1 DP-3 eDP-1
workspace $ws8 output HDMI-A-1 DP-3 eDP-1
workspace $ws9 output HDMI-A-1 DP-3 eDP-1
workspace $ws10 output eDP-1 HDMI-A-1 DP-3

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace $ws10

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace $ws10

### Layout
# The layout is selected automatically; these bindings remain available only
# as manual overrides.
bindsym $mod+b splith
bindsym $mod+v splitv
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+f fullscreen
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle
bindsym $mod+a focus parent

mode "resize" {
    bindsym $left resize shrink width 10px
    bindsym $down resize grow height 10px
    bindsym $up resize shrink height 10px
    bindsym $right resize grow width 10px
    bindsym Left resize shrink width 10px
    bindsym Down resize grow height 10px
    bindsym Up resize shrink height 10px
    bindsym Right resize grow width 10px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"
# Select and apply a desktop theme or font through the appearance applet.
bindsym $mod+Shift+t exec sh -c 'exec "${XDG_CONFIG_HOME:-$HOME/.config}/sway/scripts/theme-switcher.sh"'

### Session
bindsym $mod+Shift+c reload
# Open the session menu from Waybar's power button.
