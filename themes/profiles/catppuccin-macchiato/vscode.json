{
  "$schema": "vscode://schemas/color-theme",
  "name": "Dotfiles",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "focusBorder": "#8aadf4",
    "foreground": "#cad3f5",
    "disabledForeground": "#6e738d",
    "descriptionForeground": "#a5adcb",
    "errorForeground": "#ed8796",
