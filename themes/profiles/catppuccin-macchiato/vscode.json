    "selection.background": "#5b6078",
    "textLink.foreground": "#8aadf4",
    "textLink.activeForeground": "#7dc4e4",
    "textBlockQuote.background": "#1e2030",
    "textBlockQuote.border": "#6e738d",
    "textCodeBlock.background": "#1e2030",
    "widget.shadow": "#181926",
    "input.background": "#363a4f",
    "input.foreground": "#cad3f5",
    "input.border": "#494d64",
    "input.placeholderForeground": "#6e738d",
    "inputOption.activeBorder": "#8aadf4",
    "inputValidation.errorBackground": "#2e2030",
    "inputValidation.errorBorder": "#ed8796",
    "inputValidation.warningBackground": "#3a3223",
    "inputValidation.warningBorder": "#eed49f",
    "dropdown.background": "#363a4f",
    "dropdown.foreground": "#cad3f5",
    "dropdown.border": "#494d64",
    "button.background": "#8aadf4",
    "button.foreground": "#181926",
    "button.hoverBackground": "#78a1f6",
    "badge.background": "#c6a0f6",
    "badge.foreground": "#181926",
    "progressBar.background": "#8aadf4",
    "list.activeSelectionBackground": "#494d64",
    "list.activeSelectionForeground": "#cad3f5",
    "list.inactiveSelectionBackground": "#363a4f",
    "list.inactiveSelectionForeground": "#cad3f5",
    "list.hoverBackground": "#363a4f",
    "list.hoverForeground": "#cad3f5",
    "list.focusOutline": "#8aadf4",
    "list.highlightForeground": "#8aadf4",
    "activityBar.background": "#1e2030",
    "activityBar.foreground": "#cad3f5",
    "activityBar.inactiveForeground": "#6e738d",
    "activityBar.border": "#181926",
    "activityBarBadge.background": "#8aadf4",
    "activityBarBadge.foreground": "#181926",
    "sideBar.background": "#1e2030",
    "sideBar.foreground": "#cad3f5",
    "sideBar.border": "#181926",
    "sideBarTitle.foreground": "#cad3f5",
    "sideBarSectionHeader.background": "#24273a",
    "sideBarSectionHeader.foreground": "#cad3f5",
    "editorGroupHeader.tabsBackground": "#181926",
    "editorGroupHeader.tabsBorder": "#181926",
    "tab.activeBackground": "#24273a",
    "tab.activeForeground": "#cad3f5",
    "tab.activeBorderTop": "#8aadf4",
    "tab.inactiveBackground": "#1e2030",
    "tab.inactiveForeground": "#939ab7",
    "tab.border": "#181926",
    "editor.background": "#24273a",
    "editor.foreground": "#cad3f5",
    "editorLineNumber.foreground": "#5b6078",
    "editorLineNumber.activeForeground": "#b8c0e0",
    "editorCursor.foreground": "#f4dbd6",
    "editor.selectionBackground": "#494d64",
    "editor.inactiveSelectionBackground": "#363a4f",
    "editor.selectionHighlightBackground": "#494d6480",
    "editor.wordHighlightBackground": "#7dc4e433",
    "editor.wordHighlightStrongBackground": "#c6a0f633",
    "editor.findMatchBackground": "#eed49f66",
    "editor.findMatchBorder": "#eed49f",
    "editor.findMatchHighlightBackground": "#5b607866",
    "editor.lineHighlightBackground": "#24273a",
    "editorWhitespace.foreground": "#494d64",
    "editorIndentGuide.background1": "#363a4f",
    "editorIndentGuide.activeBackground1": "#6e738d",
    "editorBracketMatch.background": "#494d64",
    "editorBracketMatch.border": "#8bd5ca",
    "editorGutter.modifiedBackground": "#8aadf4",
    "editorGutter.addedBackground": "#a6da95",
    "editorGutter.deletedBackground": "#ed8796",
    "editorError.foreground": "#ed8796",
    "editorWarning.foreground": "#eed49f",
    "editorInfo.foreground": "#8aadf4",
    "editorHint.foreground": "#8bd5ca",
    "editorOverviewRuler.border": "#181926",
    "editorWidget.background": "#1e2030",
    "editorWidget.foreground": "#cad3f5",
    "editorWidget.border": "#494d64",
    "editorSuggestWidget.background": "#1e2030",
    "editorSuggestWidget.border": "#494d64",
    "editorSuggestWidget.selectedBackground": "#494d64",
    "editorHoverWidget.background": "#1e2030",
    "editorHoverWidget.border": "#494d64",
    "peekView.border": "#8aadf4",
    "peekViewEditor.background": "#1e2030",
    "peekViewResult.background": "#181926",
    "peekViewResult.selectionBackground": "#494d64",
    "diffEditor.insertedTextBackground": "#a6da9533",
    "diffEditor.removedTextBackground": "#ed879633",
    "minimap.background": "#24273a",
    "minimap.selectionHighlight": "#5b6078",
    "scrollbar.shadow": "#181926",
    "scrollbarSlider.background": "#5b607866",
    "scrollbarSlider.hoverBackground": "#6e738d99",
    "scrollbarSlider.activeBackground": "#939ab7aa",
    "panel.background": "#1e2030",
    "panel.border": "#494d64",
    "panelTitle.activeForeground": "#cad3f5",
    "panelTitle.activeBorder": "#8aadf4",
    "statusBar.background": "#1e2030",
    "statusBar.foreground": "#cad3f5",
    "statusBar.noFolderBackground": "#1e2030",
    "statusBar.noFolderForeground": "#cad3f5",
    "statusBar.debuggingBackground": "#f5a97f",
    "statusBar.debuggingForeground": "#181926",
    "titleBar.activeBackground": "#181926",
    "titleBar.activeForeground": "#cad3f5",
    "titleBar.inactiveBackground": "#181926",
    "titleBar.inactiveForeground": "#6e738d",
    "menu.background": "#1e2030",
    "menu.foreground": "#cad3f5",
    "menu.selectionBackground": "#494d64",
    "menu.selectionForeground": "#cad3f5",
    "menu.border": "#494d64",
    "notifications.background": "#1e2030",
    "notifications.foreground": "#cad3f5",
    "notifications.border": "#8aadf4",
    "notificationLink.foreground": "#7dc4e4",
    "breadcrumb.foreground": "#939ab7",
    "breadcrumb.focusForeground": "#cad3f5",
    "gitDecoration.addedResourceForeground": "#a6da95",
    "gitDecoration.modifiedResourceForeground": "#8aadf4",
    "gitDecoration.deletedResourceForeground": "#ed8796",
    "gitDecoration.untrackedResourceForeground": "#8bd5ca",
    "gitDecoration.ignoredResourceForeground": "#6e738d",
    "terminal.foreground": "#cad3f5",
    "terminal.background": "#24273a",
    "terminalCursor.foreground": "#f4dbd6",
    "terminal.ansiBlack": "#494d64",
    "terminal.ansiRed": "#ed8796",
    "terminal.ansiGreen": "#a6da95",
    "terminal.ansiYellow": "#eed49f",
    "terminal.ansiBlue": "#8aadf4",
    "terminal.ansiMagenta": "#f5bde6",
    "terminal.ansiCyan": "#8bd5ca",
    "terminal.ansiWhite": "#a5adcb",
    "terminal.ansiBrightBlack": "#5b6078",
    "terminal.ansiBrightRed": "#ec7486",
    "terminal.ansiBrightGreen": "#8ccf7f",
    "terminal.ansiBrightYellow": "#e1c682",
    "terminal.ansiBrightBlue": "#78a1f6",
    "terminal.ansiBrightMagenta": "#f2a9dd",
    "terminal.ansiBrightCyan": "#63cbc0",
    "terminal.ansiBrightWhite": "#b8c0e0"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#8087a2", "fontStyle": "italic" } },
    { "scope": ["string", "string.quoted", "string.template"], "settings": { "foreground": "#a6da95" } },
    { "scope": ["constant.numeric", "constant.language", "constant.character"], "settings": { "foreground": "#f5a97f" } },
    { "scope": ["keyword", "storage", "storage.type", "storage.modifier"], "settings": { "foreground": "#c6a0f6" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call"], "settings": { "foreground": "#8aadf4" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"], "settings": { "foreground": "#eed49f" } },
    { "scope": ["variable", "meta.definition.variable.name"], "settings": { "foreground": "#cad3f5" } },
    { "scope": ["variable.parameter"], "settings": { "foreground": "#f0c6c6", "fontStyle": "italic" } },
    { "scope": ["entity.name.tag", "support.class.component"], "settings": { "foreground": "#ed8796" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#eed49f" } },
    { "scope": ["keyword.operator", "punctuation.accessor"], "settings": { "foreground": "#8bd5ca" } },
    { "scope": ["punctuation", "meta.brace"], "settings": { "foreground": "#939ab7" } },
    { "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "#eed49f", "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "foreground": "#f0c6c6", "fontStyle": "italic" } },
    { "scope": ["markup.bold"], "settings": { "foreground": "#f0c6c6", "fontStyle": "bold" } },
    { "scope": ["markup.underline.link", "string.other.link"], "settings": { "foreground": "#7dc4e4", "fontStyle": "underline" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "#a6da95" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "#ed8796" } },
    { "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#ed8796", "fontStyle": "underline" } }
  ],
  "semanticTokenColors": {
    "namespace": "#eed49f",
    "type": "#eed49f",
    "class": "#eed49f",
    "enum": "#eed49f",
    "interface": "#eed49f",
    "struct": "#eed49f",
    "typeParameter": "#eed49f",
    "parameter": { "foreground": "#f0c6c6", "italic": true },
    "variable": "#cad3f5",
    "property": "#b7bdf8",
    "enumMember": "#f5a97f",
    "function": "#8aadf4",
    "method": "#8aadf4",
    "keyword": "#c6a0f6",
    "comment": { "foreground": "#8087a2", "italic": true },
    "string": "#a6da95",
    "number": "#f5a97f",
    "operator": "#8bd5ca"
  }
}
