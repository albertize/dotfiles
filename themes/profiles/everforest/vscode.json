{
  "$schema": "vscode://schemas/color-theme",
  "name": "Dotfiles",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "focusBorder": "#a7c080",
    "foreground": "#d3c6aa",
    "disabledForeground": "#56635f",
    "descriptionForeground": "#9da9a0",
    "errorForeground": "#e67e80",
