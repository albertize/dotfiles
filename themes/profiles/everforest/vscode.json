    "selection.background": "#475258",
    "textLink.foreground": "#a7c080",
    "textLink.activeForeground": "#7fbbb3",
    "textBlockQuote.background": "#232a2e",
    "textBlockQuote.border": "#56635f",
    "textCodeBlock.background": "#232a2e",
    "widget.shadow": "#1e2326",
    "input.background": "#343f44",
    "input.foreground": "#d3c6aa",
    "input.border": "#3d484d",
    "input.placeholderForeground": "#56635f",
    "inputOption.activeBorder": "#a7c080",
    "inputValidation.errorBackground": "#4b383b",
    "inputValidation.errorBorder": "#e67e80",
    "inputValidation.warningBackground": "#4d4c43",
    "inputValidation.warningBorder": "#dbbc7f",
    "dropdown.background": "#343f44",
    "dropdown.foreground": "#d3c6aa",
    "dropdown.border": "#3d484d",
    "button.background": "#a7c080",
    "button.foreground": "#1e2326",
    "button.hoverBackground": "#83c092",
    "badge.background": "#d699b6",
    "badge.foreground": "#1e2326",
    "progressBar.background": "#a7c080",
    "list.activeSelectionBackground": "#3d484d",
    "list.activeSelectionForeground": "#d3c6aa",
    "list.inactiveSelectionBackground": "#343f44",
    "list.inactiveSelectionForeground": "#d3c6aa",
    "list.hoverBackground": "#343f44",
    "list.hoverForeground": "#d3c6aa",
    "list.focusOutline": "#a7c080",
    "list.highlightForeground": "#a7c080",
    "activityBar.background": "#232a2e",
    "activityBar.foreground": "#d3c6aa",
    "activityBar.inactiveForeground": "#56635f",
    "activityBar.border": "#1e2326",
    "activityBarBadge.background": "#a7c080",
    "activityBarBadge.foreground": "#1e2326",
    "sideBar.background": "#232a2e",
    "sideBar.foreground": "#d3c6aa",
    "sideBar.border": "#1e2326",
    "sideBarTitle.foreground": "#d3c6aa",
    "sideBarSectionHeader.background": "#2d353b",
    "sideBarSectionHeader.foreground": "#d3c6aa",
    "editorGroupHeader.tabsBackground": "#1e2326",
    "editorGroupHeader.tabsBorder": "#1e2326",
    "tab.activeBackground": "#2d353b",
    "tab.activeForeground": "#d3c6aa",
    "tab.activeBorderTop": "#a7c080",
    "tab.inactiveBackground": "#232a2e",
    "tab.inactiveForeground": "#859289",
    "tab.border": "#1e2326",
    "editor.background": "#2d353b",
    "editor.foreground": "#d3c6aa",
    "editorLineNumber.foreground": "#475258",
    "editorLineNumber.activeForeground": "#9da9a0",
    "editorCursor.foreground": "#d3c6aa",
    "editor.selectionBackground": "#3d484d",
    "editor.inactiveSelectionBackground": "#343f44",
    "editor.selectionHighlightBackground": "#3d484d80",
    "editor.wordHighlightBackground": "#7fbbb333",
    "editor.wordHighlightStrongBackground": "#d699b633",
    "editor.findMatchBackground": "#dbbc7f66",
    "editor.findMatchBorder": "#dbbc7f",
    "editor.findMatchHighlightBackground": "#47525866",
    "editor.lineHighlightBackground": "#2d353b",
    "editorWhitespace.foreground": "#3d484d",
    "editorIndentGuide.background1": "#343f44",
    "editorIndentGuide.activeBackground1": "#56635f",
    "editorBracketMatch.background": "#3d484d",
    "editorBracketMatch.border": "#83c092",
    "editorGutter.modifiedBackground": "#a7c080",
    "editorGutter.addedBackground": "#a7c080",
    "editorGutter.deletedBackground": "#e67e80",
    "editorError.foreground": "#e67e80",
    "editorWarning.foreground": "#dbbc7f",
    "editorInfo.foreground": "#a7c080",
    "editorHint.foreground": "#83c092",
    "editorOverviewRuler.border": "#1e2326",
    "editorWidget.background": "#232a2e",
    "editorWidget.foreground": "#d3c6aa",
    "editorWidget.border": "#3d484d",
    "editorSuggestWidget.background": "#232a2e",
    "editorSuggestWidget.border": "#3d484d",
    "editorSuggestWidget.selectedBackground": "#3d484d",
    "editorHoverWidget.background": "#232a2e",
    "editorHoverWidget.border": "#3d484d",
    "peekView.border": "#a7c080",
    "peekViewEditor.background": "#232a2e",
    "peekViewResult.background": "#1e2326",
    "peekViewResult.selectionBackground": "#3d484d",
    "diffEditor.insertedTextBackground": "#a7c08033",
    "diffEditor.removedTextBackground": "#e67e8033",
    "minimap.background": "#2d353b",
    "minimap.selectionHighlight": "#475258",
    "scrollbar.shadow": "#1e2326",
    "scrollbarSlider.background": "#47525866",
    "scrollbarSlider.hoverBackground": "#56635f99",
    "scrollbarSlider.activeBackground": "#859289aa",
    "panel.background": "#232a2e",
    "panel.border": "#3d484d",
    "panelTitle.activeForeground": "#d3c6aa",
    "panelTitle.activeBorder": "#a7c080",
    "statusBar.background": "#232a2e",
    "statusBar.foreground": "#d3c6aa",
    "statusBar.noFolderBackground": "#232a2e",
    "statusBar.noFolderForeground": "#d3c6aa",
    "statusBar.debuggingBackground": "#e69875",
    "statusBar.debuggingForeground": "#1e2326",
    "titleBar.activeBackground": "#1e2326",
    "titleBar.activeForeground": "#d3c6aa",
    "titleBar.inactiveBackground": "#1e2326",
    "titleBar.inactiveForeground": "#56635f",
    "menu.background": "#232a2e",
    "menu.foreground": "#d3c6aa",
    "menu.selectionBackground": "#3d484d",
    "menu.selectionForeground": "#d3c6aa",
    "menu.border": "#3d484d",
    "notifications.background": "#232a2e",
    "notifications.foreground": "#d3c6aa",
    "notifications.border": "#a7c080",
    "notificationLink.foreground": "#7fbbb3",
    "breadcrumb.foreground": "#859289",
    "breadcrumb.focusForeground": "#d3c6aa",
    "gitDecoration.addedResourceForeground": "#a7c080",
    "gitDecoration.modifiedResourceForeground": "#a7c080",
    "gitDecoration.deletedResourceForeground": "#e67e80",
    "gitDecoration.untrackedResourceForeground": "#83c092",
    "gitDecoration.ignoredResourceForeground": "#56635f",
    "terminal.foreground": "#d3c6aa",
    "terminal.background": "#2d353b",
    "terminalCursor.foreground": "#d3c6aa",
    "terminal.ansiBlack": "#3d484d",
    "terminal.ansiRed": "#e67e80",
    "terminal.ansiGreen": "#a7c080",
    "terminal.ansiYellow": "#dbbc7f",
    "terminal.ansiBlue": "#a7c080",
    "terminal.ansiMagenta": "#d699b6",
    "terminal.ansiCyan": "#83c092",
    "terminal.ansiWhite": "#9da9a0",
    "terminal.ansiBrightBlack": "#475258",
    "terminal.ansiBrightRed": "#e67e80",
    "terminal.ansiBrightGreen": "#a7c080",
    "terminal.ansiBrightYellow": "#dbbc7f",
    "terminal.ansiBrightBlue": "#83c092",
    "terminal.ansiBrightMagenta": "#d699b6",
    "terminal.ansiBrightCyan": "#83c092",
    "terminal.ansiBrightWhite": "#9da9a0"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#7a8478", "fontStyle": "italic" } },
    { "scope": ["string", "string.quoted", "string.template"], "settings": { "foreground": "#a7c080" } },
    { "scope": ["constant.numeric", "constant.language", "constant.character"], "settings": { "foreground": "#e69875" } },
    { "scope": ["keyword", "storage", "storage.type", "storage.modifier"], "settings": { "foreground": "#d699b6" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call"], "settings": { "foreground": "#a7c080" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"], "settings": { "foreground": "#dbbc7f" } },
    { "scope": ["variable", "meta.definition.variable.name"], "settings": { "foreground": "#d3c6aa" } },
    { "scope": ["variable.parameter"], "settings": { "foreground": "#9da9a0", "fontStyle": "italic" } },
    { "scope": ["entity.name.tag", "support.class.component"], "settings": { "foreground": "#e67e80" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#dbbc7f" } },
    { "scope": ["keyword.operator", "punctuation.accessor"], "settings": { "foreground": "#83c092" } },
    { "scope": ["punctuation", "meta.brace"], "settings": { "foreground": "#859289" } },
    { "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "#dbbc7f", "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "foreground": "#9da9a0", "fontStyle": "italic" } },
    { "scope": ["markup.bold"], "settings": { "foreground": "#9da9a0", "fontStyle": "bold" } },
    { "scope": ["markup.underline.link", "string.other.link"], "settings": { "foreground": "#7fbbb3", "fontStyle": "underline" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "#a7c080" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "#e67e80" } },
    { "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#e67e80", "fontStyle": "underline" } }
  ],
  "semanticTokenColors": {
    "namespace": "#dbbc7f",
    "type": "#dbbc7f",
    "class": "#dbbc7f",
    "enum": "#dbbc7f",
    "interface": "#dbbc7f",
    "struct": "#dbbc7f",
    "typeParameter": "#dbbc7f",
    "parameter": { "foreground": "#9da9a0", "italic": true },
    "variable": "#d3c6aa",
    "property": "#d699b6",
    "enumMember": "#e69875",
    "function": "#a7c080",
    "method": "#a7c080",
    "keyword": "#d699b6",
    "comment": { "foreground": "#7a8478", "italic": true },
    "string": "#a7c080",
    "number": "#e69875",
    "operator": "#83c092"
  }
}
