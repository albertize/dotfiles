    "inputValidation.warningBackground": "#3a3223",
    "inputValidation.warningBorder": "#fabd2f",
    "dropdown.background": "#3c3836",
    "dropdown.foreground": "#ebdbb2",
    "dropdown.border": "#504945",
    "button.background": "#83a598",
    "button.foreground": "#1d2021",
    "button.hoverBackground": "#8ec07c",
    "badge.background": "#d3869b",
    "badge.foreground": "#1d2021",
    "progressBar.background": "#83a598",
    "list.activeSelectionBackground": "#504945",
    "list.activeSelectionForeground": "#ebdbb2",
    "list.inactiveSelectionBackground": "#3c3836",
    "list.inactiveSelectionForeground": "#ebdbb2",
    "list.hoverBackground": "#3c3836",
    "list.hoverForeground": "#ebdbb2",
    "list.focusOutline": "#83a598",
    "list.highlightForeground": "#83a598",
    "activityBar.background": "#1d2021",
    "activityBar.foreground": "#ebdbb2",
    "activityBar.inactiveForeground": "#7c6f64",
    "activityBar.border": "#1d2021",
    "activityBarBadge.background": "#83a598",
    "activityBarBadge.foreground": "#1d2021",
    "sideBar.background": "#1d2021",
    "sideBar.foreground": "#ebdbb2",
    "sideBar.border": "#1d2021",
    "sideBarTitle.foreground": "#ebdbb2",
    "sideBarSectionHeader.background": "#282828",
    "sideBarSectionHeader.foreground": "#ebdbb2",
    "editorGroupHeader.tabsBackground": "#1d2021",
    "editorGroupHeader.tabsBorder": "#1d2021",
    "tab.activeBackground": "#282828",
    "tab.activeForeground": "#ebdbb2",
    "tab.activeBorderTop": "#83a598",
    "tab.inactiveBackground": "#1d2021",
    "tab.inactiveForeground": "#a89984",
    "tab.border": "#1d2021",
    "editor.background": "#282828",
    "editor.foreground": "#ebdbb2",
    "editorLineNumber.foreground": "#665c54",
    "editorLineNumber.activeForeground": "#d5c4a1",
    "editorCursor.foreground": "#ebdbb2",
    "editor.selectionBackground": "#504945",
    "editor.inactiveSelectionBackground": "#3c3836",
    "editor.selectionHighlightBackground": "#50494580",
    "editor.wordHighlightBackground": "#83a59833",
    "editor.wordHighlightStrongBackground": "#d3869b33",
    "editor.findMatchBackground": "#fabd2f66",
    "editor.findMatchBorder": "#fabd2f",
    "editor.findMatchHighlightBackground": "#665c5466",
    "editor.lineHighlightBackground": "#282828",
    "editorWhitespace.foreground": "#504945",
    "editorIndentGuide.background1": "#3c3836",
    "editorIndentGuide.activeBackground1": "#7c6f64",
    "editorBracketMatch.background": "#504945",
    "editorBracketMatch.border": "#8ec07c",
    "editorGutter.modifiedBackground": "#83a598",
    "editorGutter.addedBackground": "#b8bb26",
    "editorGutter.deletedBackground": "#fb4934",
    "editorError.foreground": "#fb4934",
    "editorWarning.foreground": "#fabd2f",
    "editorInfo.foreground": "#83a598",
    "editorHint.foreground": "#8ec07c",
    "editorOverviewRuler.border": "#1d2021",
    "editorWidget.background": "#1d2021",
    "editorWidget.foreground": "#ebdbb2",
    "editorWidget.border": "#504945",
    "editorSuggestWidget.background": "#1d2021",
    "editorSuggestWidget.border": "#504945",
    "editorSuggestWidget.selectedBackground": "#504945",
    "editorHoverWidget.background": "#1d2021",
    "editorHoverWidget.border": "#504945",
    "peekView.border": "#83a598",
    "peekViewEditor.background": "#1d2021",
    "peekViewResult.background": "#1d2021",
    "peekViewResult.selectionBackground": "#504945",
    "diffEditor.insertedTextBackground": "#b8bb2633",
    "diffEditor.removedTextBackground": "#fb493433",
    "minimap.background": "#282828",
    "minimap.selectionHighlight": "#665c54",
    "scrollbar.shadow": "#1d2021",
    "scrollbarSlider.background": "#665c5466",
    "scrollbarSlider.hoverBackground": "#7c6f6499",
    "scrollbarSlider.activeBackground": "#a89984aa",
    "panel.background": "#1d2021",
    "panel.border": "#504945",
    "panelTitle.activeForeground": "#ebdbb2",
    "panelTitle.activeBorder": "#83a598",
    "statusBar.background": "#1d2021",
    "statusBar.foreground": "#ebdbb2",
    "statusBar.noFolderBackground": "#1d2021",
    "statusBar.noFolderForeground": "#ebdbb2",
    "statusBar.debuggingBackground": "#fe8019",
    "statusBar.debuggingForeground": "#1d2021",
    "titleBar.activeBackground": "#1d2021",
    "titleBar.activeForeground": "#ebdbb2",
    "titleBar.inactiveBackground": "#1d2021",
    "titleBar.inactiveForeground": "#7c6f64",
    "menu.background": "#1d2021",
    "menu.foreground": "#ebdbb2",
    "menu.selectionBackground": "#504945",
    "menu.selectionForeground": "#ebdbb2",
    "menu.border": "#504945",
    "notifications.background": "#1d2021",
    "notifications.foreground": "#ebdbb2",
    "notifications.border": "#83a598",
    "notificationLink.foreground": "#83a598",
    "breadcrumb.foreground": "#a89984",
    "breadcrumb.focusForeground": "#ebdbb2",
    "gitDecoration.addedResourceForeground": "#b8bb26",
    "gitDecoration.modifiedResourceForeground": "#83a598",
    "gitDecoration.deletedResourceForeground": "#fb4934",
    "gitDecoration.untrackedResourceForeground": "#8ec07c",
    "gitDecoration.ignoredResourceForeground": "#7c6f64",
    "terminal.foreground": "#ebdbb2",
    "terminal.background": "#282828",
    "terminalCursor.foreground": "#ebdbb2",
    "terminal.ansiBlack": "#504945",
    "terminal.ansiRed": "#fb4934",
    "terminal.ansiGreen": "#b8bb26",
    "terminal.ansiYellow": "#fabd2f",
    "terminal.ansiBlue": "#83a598",
    "terminal.ansiMagenta": "#d3869b",
    "terminal.ansiCyan": "#8ec07c",
    "terminal.ansiWhite": "#d5c4a1",
    "terminal.ansiBrightBlack": "#665c54",
    "terminal.ansiBrightRed": "#fb4934",
    "terminal.ansiBrightGreen": "#b8bb26",
    "terminal.ansiBrightYellow": "#fabd2f",
    "terminal.ansiBrightBlue": "#8ec07c",
    "terminal.ansiBrightMagenta": "#d3869b",
    "terminal.ansiBrightCyan": "#8ec07c",
    "terminal.ansiBrightWhite": "#d5c4a1"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#928374", "fontStyle": "italic" } },
    { "scope": ["string", "string.quoted", "string.template"], "settings": { "foreground": "#b8bb26" } },
    { "scope": ["constant.numeric", "constant.language", "constant.character"], "settings": { "foreground": "#fe8019" } },
    { "scope": ["keyword", "storage", "storage.type", "storage.modifier"], "settings": { "foreground": "#d3869b" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call"], "settings": { "foreground": "#83a598" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"], "settings": { "foreground": "#fabd2f" } },
    { "scope": ["variable", "meta.definition.variable.name"], "settings": { "foreground": "#ebdbb2" } },
    { "scope": ["variable.parameter"], "settings": { "foreground": "#d5c4a1", "fontStyle": "italic" } },
    { "scope": ["entity.name.tag", "support.class.component"], "settings": { "foreground": "#fb4934" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#fabd2f" } },
    { "scope": ["keyword.operator", "punctuation.accessor"], "settings": { "foreground": "#8ec07c" } },
    { "scope": ["punctuation", "meta.brace"], "settings": { "foreground": "#a89984" } },
    { "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "#fabd2f", "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "foreground": "#d5c4a1", "fontStyle": "italic" } },
    { "scope": ["markup.bold"], "settings": { "foreground": "#d5c4a1", "fontStyle": "bold" } },
    { "scope": ["markup.underline.link", "string.other.link"], "settings": { "foreground": "#83a598", "fontStyle": "underline" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "#b8bb26" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "#fb4934" } },
    { "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#fb4934", "fontStyle": "underline" } }
  ],
  "semanticTokenColors": {
    "namespace": "#fabd2f",
    "type": "#fabd2f",
    "class": "#fabd2f",
    "enum": "#fabd2f",
    "interface": "#fabd2f",
    "struct": "#fabd2f",
    "typeParameter": "#fabd2f",
    "parameter": { "foreground": "#d5c4a1", "italic": true },
    "variable": "#ebdbb2",
    "property": "#d3869b",
    "enumMember": "#fe8019",
    "function": "#83a598",
    "method": "#83a598",
    "keyword": "#d3869b",
    "comment": { "foreground": "#928374", "italic": true },
    "string": "#b8bb26",
    "number": "#fe8019",
    "operator": "#8ec07c"
  }
}
